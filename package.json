{
    "name": "deadeye",
    "displayName": "Deadeye",
    "description": "Supercharged snippet and completion engine.",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.118.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "deadeyeInspector",
                    "title": "Deadeye Inspector",
                    "icon": "$(whole-word)"
                }
            ]
        },
        "views": {
            "deadeyeInspector": [
                {
                    "id": "tokenExplorer",
                    "name": "Tokens",
                    "icon": "$(whole-word)"
                },
                {
                    "id": "scopeExplorer",
                    "name": "Scopes",
                    "icon": "$(symbol-namespace)"
                }
            ]
        },
        "commands": [
            {
                "command": "deadeye.tokenExplorer.jumpTo",
                "title": "Jump to Token in Active Document",
                "category": "Deadeye Inspector",
                "icon": "$(debug-step-into)"
            },
            {
                "command": "deadeye.scopeExplorer.jumpTo",
                "title": "Jump to Scope Marker and Region in Active Document",
                "category": "Deadeye Inspector",
                "icon": "$(debug-step-into)"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "clean": "rimraf out",
        "pretest": "pnpm run compile-tests && pnpm run compile",
        "compile": "vite build",
        "compile-tests": "tsc -p . --outDir out",
        "watch": "vite build --watch",
        "watch-tests": "tsc -p . -w --outDir out",
        "watch-all": "concurrently \"pnpm watch\" \"pnpm watch-tests\"",
        "package": "vite build --mode production",
        "lint": "eslint src",
        "test": "vscode-test --attach-argv --enable-logging",
        "format": "prettier . --write"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.1.2",
        "@types/vscode": "^1.125.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "concurrently": "^10.0.4",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "rimraf": "^6.1.3",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0"
    },
    "dependencies": {
        "@flatten-js/interval-tree": "^2.0.3",
        "dedent-js": "^1.0.1",
        "misspellings": "^1.1.0"
    }
}
