{
    "name": "deadeye",
    "displayName": "Deadeye",
    "description": "Supercharged snippet and completion engine.",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.118.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "clean": "rimraf out",
        "pretest": "pnpm run compile-tests && pnpm run compile",
        "compile": "vite build",
        "compile-tests": "tsc -p . --outDir out",
        "watch": "vite build --watch",
        "watch-tests": "tsc -p . -w --outDir out",
        "watch-all": "concurrently \"pnpm watch\" \"pnpm watch-tests\"",
        "package": "vite build --mode production",
        "lint": "eslint src",
        "test": "vscode-test --attach-argv --enable-logging",
        "format": "prettier . --write"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.0.0",
        "@types/vscode": "^1.125.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "concurrently": "^9.1.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.0"
    },
    "dependencies": {
        "@flatten-js/interval-tree": "^2.0.3",
        "dedent-js": "^1.0.1",
        "misspellings": "^1.1.0"
    }
}
